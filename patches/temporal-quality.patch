--- /dev/null
+++ b/Source/Games/Metaphor ReFantazio/temporal_quality.h	
@@ -0,0 +1,59 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+namespace MetaphorTemporal
+{
+   // m02/m12 jitter divided by clip.w gives a UV shift of -jitter/m32.
+   // Derive the sign from the actual projection (left- or right-handed).
+   inline float HistoryJitterPixels(float current, float previous, float current_m32, float previous_m32)
+   {
+      if (!std::isfinite(current_m32) || !std::isfinite(previous_m32)
+         || std::abs(current_m32) < 1e-6f || std::abs(previous_m32) < 1e-6f)
+         return 0.f;
+      return current / current_m32 - previous / previous_m32;
+   }
+
+   // Conservative discontinuity detection, independent of the game's world units.
+   // Translation alone cannot distinguish a teleport from a fast continuous pan.
+   template<class Matrix>
+   bool CameraDiscontinuity(const Matrix& view, const Matrix& previous_view,
+      const Matrix& projection, const Matrix& previous_projection)
+   {
+      const float axes[3][3] = {{view.m00, view.m01, view.m02}, {view.m10, view.m11, view.m12}, {view.m20, view.m21, view.m22}};
+      const float previous_axes[3][3] = {{previous_view.m00, previous_view.m01, previous_view.m02},
+         {previous_view.m10, previous_view.m11, previous_view.m12}, {previous_view.m20, previous_view.m21, previous_view.m22}};
+      float trace = 0.f;
+      for (int i = 0; i < 3; ++i)
+      {
+         float dot = 0.f, a2 = 0.f, b2 = 0.f;
+         for (int j = 0; j < 3; ++j)
+         {
+            dot += axes[i][j] * previous_axes[i][j];
+            a2 += axes[i][j] * axes[i][j];
+            b2 += previous_axes[i][j] * previous_axes[i][j];
+         }
+         if (!std::isfinite(dot) || !std::isfinite(a2 * b2) || a2 * b2 < 1e-12f)
+            return true;
+         trace += dot / std::sqrt(a2 * b2);
+      }
+      // trace(R) = 1 + 2 cos(angle): reset for a >60 degree cut in one frame.
+      if (trace < 2.f) return true;
+      const float current[] = {projection.m00, projection.m11};
+      const float previous[] = {previous_projection.m00, previous_projection.m11};
+      for (int i = 0; i < 2; ++i)
+      {
+         if (!std::isfinite(current[i]) || !std::isfinite(previous[i]) || std::abs(previous[i]) < 1e-6f
+            || std::abs(current[i] / previous[i] - 1.f) > 0.2f)
+            return true;
+      }
+      return false;
+   }
+
+   inline float TextureBias(float render_height, float output_height, float detail_bias)
+   {
+      if (!(render_height > 0.f) || !(output_height > 0.f)) return 0.f;
+      return std::log2(render_height / (std::max)(render_height, output_height)) + detail_bias;
+   }
+}
